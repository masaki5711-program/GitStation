{
  "api_version": "v1",
  "commands": [
    {
      "args": [
        {
          "description": "Read the token from standard input (never prompts, never an argument).",
          "kind": "flag",
          "name": "--with-token",
          "repeatable": false,
          "required": true
        }
      ],
      "examples": [
        "gstn auth login --with-token < token.txt",
        "echo $TOKEN | gstn --host https://git.example.internal auth login --with-token"
      ],
      "name": "auth login",
      "output": {
        "properties": {
          "host": {
            "type": "string"
          },
          "is_agent": {
            "type": "boolean"
          },
          "stored_in": {
            "enum": [
              "keyring",
              "file"
            ]
          },
          "token_scopes": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "username",
          "is_agent",
          "token_scopes",
          "stored_in"
        ],
        "type": "object"
      },
      "routes": [
        "GET /api/v1/user"
      ],
      "scopes": [
        "read_api"
      ],
      "summary": "Verify a token against the server and store it (OS credential store, else a 0600 file)."
    },
    {
      "args": [],
      "examples": [
        "gstn auth status --json"
      ],
      "name": "auth status",
      "output": {
        "properties": {
          "host": {
            "type": "string"
          },
          "logged_in": {
            "const": true
          },
          "token_scopes": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "token_source": {
            "enum": [
              "env",
              "keyring",
              "file"
            ]
          },
          "user": {
            "required": [
              "id",
              "username",
              "display_name",
              "is_admin",
              "is_agent"
            ],
            "type": "object"
          }
        },
        "required": [
          "host",
          "logged_in",
          "user",
          "token_scopes",
          "token_source"
        ],
        "type": "object"
      },
      "routes": [
        "GET /api/v1/user"
      ],
      "scopes": [
        "read_api"
      ],
      "summary": "Show who the stored token belongs to: user, scopes, is_agent. Never the token."
    },
    {
      "args": [],
      "examples": [
        "gstn auth logout"
      ],
      "name": "auth logout",
      "output": {
        "properties": {
          "host": {
            "type": "string"
          },
          "removed": {
            "type": "boolean"
