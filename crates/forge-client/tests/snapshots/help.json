        },
        "required": [
          "host",
          "removed"
        ],
        "type": "object"
      },
      "routes": [],
      "scopes": [],
      "summary": "Remove the stored token for the host (does not revoke it on the server)."
    },
    {
      "args": [
        {
          "description": "get | store | erase (git passes it; reads key=value lines on stdin).",
          "kind": "positional",
          "name": "operation",
          "repeatable": false,
          "required": false
        },
        {
          "description": "Register this helper for the configured host: git config --global credential.<host>.helper.",
          "kind": "flag",
          "name": "--install",
          "repeatable": false,
          "required": false
        }
      ],
      "examples": [
        "gstn auth git-credential --install",
        "git clone https://git.example.internal/team/app.git"
      ],
      "name": "auth git-credential",
      "output": {
        "description": "--install only; get/store/erase speak the git credential protocol on stdout",
        "properties": {
          "git_config_key": {
            "type": "string"
          },
          "helper": {
            "type": "string"
          },
          "installed": {
            "type": "boolean"
          }
        },
        "required": [
          "installed",
          "git_config_key",
          "helper"
        ],
        "type": "object"
      },
      "routes": [],
      "scopes": [
        "read_repository",
        "write_repository"
      ],
      "summary": "git credential helper for the configured host only (get/store/erase), or --install it in the global git config."
    },
    {
