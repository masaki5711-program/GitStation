# /etc/forge/forgectl.env — the privileged database logins for `forgectl`
# (ops/linux/bin/forgectl). root:root 0600. KEY=VALUE lines only (no shell:
# the file is parsed, never sourced); `#` lines and blank lines are ignored.
#
# These are URLs, not secrets (a URL that carries a password is refused,
# FG-SYS-0002 reason=password_in_url). The passwords stay in
# /etc/forge/secrets-privileged/ (root:root 0700, files 0600).
#
# PLACEHOLDER host/port: the same server as database.url in forge.toml.

# forge_migrator: `forgectl db migrate` (ADR-0018 §2).
FORGE_DATABASE_MIGRATE_URL=postgres://forge_migrator@127.0.0.1:55433/forge
# forge_maint: `forgectl restore finish`, `forgectl admin events new-epoch`.
FORGE_DATABASE_MAINT_URL=postgres://forge_maint@127.0.0.1:55433/forge
