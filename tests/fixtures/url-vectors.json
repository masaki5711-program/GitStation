        "route": "receive_pack"
      }
    },
    {
      "name": "POST ignores the query",
      "path": "/acme/x.git/git-upload-pack",
      "query": "service=bogus",
      "form": "both",
      "expect": {
        "kind": "git",
        "namespace": "acme/x",
