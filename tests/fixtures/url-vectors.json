{
  "schema": 1,
  "about": "Shared URL vectors for ADR-0015 (parse_web_path in forge-core, later the forge-web dispatcher and the SPA). `path` is exactly what the server receives (req.uri().path()); `query` the raw query string without '?', absent = none. `form`: `both` = a browser's new URL() leaves the path unchanged and curl --path-as-is sends it as is; `browser` = what new URL(browser_input, base).pathname produces; `raw` = only reachable as raw bytes (curl --path-as-is), a browser would rewrite it first. Accepted vectors carry `expect`; namespaces are folded and joined with '/', `rest` holds the decoded tail segments. Rejected vectors carry the FG-WEB-0001 `reason`; `dot_git` marks the places a `.git` segment is not allowed. Generated once and edited by hand; keep names unique.",
  "accept": [
    {
      "name": "top-level namespace",
      "path": "/acme",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "acme"
      }
    },
    {
      "name": "nested namespace",
      "path": "/acme/platform/infra/forge-web",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "acme/platform/infra/forge-web"
      }
    },
    {
      "name": "namespace is folded to ASCII lowercase",
      "path": "/Acme/Forge-Web",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "acme/forge-web"
      }
    },
    {
      "name": "a dot at the top level (user name)",
      "path": "/john.doe/notes",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "john.doe/notes"
      }
    },
    {
      "name": "a reserved word below the top level",
      "path": "/acme/api/settings",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "acme/api/settings"
      }
    },
    {
      "name": "GitHub-style words without /-/ are a namespace home",
      "path": "/acme/x/blob/main/README.md",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "acme/x/blob/main/readme.md"
      }
    },
    {
      "name": "info/refs without .git is a namespace home",
      "path": "/acme/x/info/refs",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "acme/x/info/refs"
      }
    },
    {
      "name": "20 levels deep",
      "path": "/a/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r/s/t",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "a/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r/s/t"
      }
    },
    {
      "name": "full path of exactly 255 characters",
      "path": "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc/dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc/dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      }
    },
    {
      "name": "segment of 64 characters",
      "path": "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "form": "both",
      "expect": {
        "kind": "home",
        "namespace": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "name": "blob with a file",
      "path": "/acme/forge-web/-/blob/main/README.md",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/forge-web",
        "word": "blob",
        "rest": [
          "main",
          "README.md"
        ]
      }
    },
    {
      "name": "tree with no rest",
