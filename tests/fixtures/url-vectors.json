      "path": "/acme/x/-",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "percent in the namespace",
      "path": "/acme/%78",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "encoded slash in the namespace",
      "path": "/acme%2Fx",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "encoded lowercase slash in the namespace",
      "path": "/acme%2fx",
      "form": "both",
      "reason": "path_rejected"
    },
    {
