      }
    },
    {
      "name": "double-encoded separator decodes once to text",
      "path": "/acme/x/-/blob/main/a%252Fb",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/x",
        "word": "blob",
        "rest": [
          "main",
          "a%2Fb"
        ]
      }
    },
    {
      "name": "a dash segment in the tail is a name",
      "path": "/acme/x/-/blob/main/-/x",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/x",
        "word": "blob",
        "rest": [
          "main",
          "-",
          "x"
        ]
      }
    },
    {
      "name": "a .git file in the tail",
      "path": "/acme/x/-/blob/main/vendor/lib.git",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/x",
        "word": "blob",
        "rest": [
          "main",
          "vendor",
          "lib.git"
        ]
      }
    },
    {
      "name": "a tail segment may start with dashes",
      "path": "/acme/x/-/blob/main/--output=x",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/x",
        "word": "blob",
        "rest": [
          "main",
          "--output=x"
        ]
      }
    },
    {
      "name": "three dots are a name",
      "path": "/acme/x/-/blob/main/...",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/x",
        "word": "blob",
        "rest": [
          "main",
          "..."
        ]
      }
    },
    {
      "name": "hidden file",
      "path": "/acme/x/-/blob/main/.gitignore",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/x",
        "word": "blob",
        "rest": [
          "main",
          ".gitignore"
        ]
      }
    },
    {
      "name": "archive with extension",
      "path": "/acme/x/-/archive/v1.0.tar.gz",
      "form": "both",
      "expect": {
        "kind": "scoped",
        "namespace": "acme/x",
        "word": "archive",
        "rest": [
          "v1.0.tar.gz"
        ]
      }
    },
    {
      "name": "the query of a scoped route is ignored",
