  "reject": [
    {
      "name": "no leading slash",
      "path": "acme/x",
      "form": "raw",
      "reason": "path_rejected"
    },
    {
      "name": "the root",
      "path": "/",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "empty path",
      "path": "",
      "form": "raw",
      "reason": "path_rejected"
    },
    {
      "name": "double slash at the start",
      "path": "//acme",
      "form": "raw",
      "reason": "path_rejected"
    },
    {
      "name": "double slash in the namespace",
      "path": "/acme//x",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "trailing slash on a namespace",
      "path": "/acme/x/",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "trailing slash on a scoped route",
      "path": "/acme/x/-/tree/main/",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "double slash in the tail",
      "path": "/acme/x/-/blob//a",
      "form": "both",
      "reason": "path_rejected"
    },
    {
      "name": "trailing slash on info/refs",
      "path": "/acme/x.git/info/refs/",
      "query": "service=git-upload-pack",
      "form": "both",
      "reason": "path_rejected",
      "dot_git": true
    },
    {
      "name": "21 levels deep",
      "path": "/a/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r/s/t/u",
      "form": "both",
      "reason": "path_rejected"
    },
    {
