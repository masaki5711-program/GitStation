            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "kind": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/KindName",
                "description": "Default `system`."
              }
            ]
          },
          "namespace_id": {
            "description": "The parent: a personal or a group namespace (`namespace_id` of a\nuser, of `GET /api/v1/groups/{id}` or of the resolver).",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "The path segment (ADR-0015 rules).",
            "type": "string"
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VisibilityName",
                "description": "Default `private`."
              }
            ]
          }
        },
        "required": [
          "namespace_id",
          "path",
          "display_name"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "pattern": "^FG-[A-Z]+-[0-9]{4}$",
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "user_message": {
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "user_message",
          "request_id"
        ],
        "type": "object"
      },
