        "type": "object"
      },
      "KindName": {
        "description": "A repository kind in a request (ADR-0004; fixed at creation).",
        "enum": [
          "spec",
          "system"
        ],
        "type": "string"
      },
      "ProjectBody": {
        "additionalProperties": false,
        "description": "A project as the API shows it.",
