{
  "$comment": "Mirror of the colour tokens in tokens.css (ADR-0022 §4), for Kanflow. tests/tokens.test.ts keeps the two equal.",
  "color": {
    "--gs-brand-navy": "#1b2a44",
    "--gs-brand-teal": "#22b8a0",
    "--gs-brand-teal-strong": "#128f7c",
    "--gs-brand-orange": "#ff7a45",
    "--gs-brand-paper": "#f4fbfc",
    "--gs-color-white": "#ffffff",
    "--gs-color-text": "#1b2a44",
    "--gs-color-text-muted": "#4a5568",
    "--gs-color-border": "#c9d3dd",
    "--gs-color-surface": "#ffffff",
    "--gs-color-background": "#f4fbfc",
    "--gs-color-link": "#0f7a69",
    "--gs-color-action": "#0f7a69",
    "--gs-color-focus": "#128f7c",
    "--gs-color-danger-text": "#a61b1b",
    "--gs-color-danger-surface": "#fdecec",
    "--gs-color-danger-border": "#e08a8a",
    "--gs-color-warning-text": "#7a4a00",
    "--gs-color-warning-surface": "#fff4e0",
    "--gs-color-success-text": "#1f6b3a",
    "--gs-color-success-surface": "#e8f6ee",
    "--gs-header-background": "#1b2a44",
    "--gs-header-text": "#f4fbfc"
  },
  "textPairs": [
    ["--gs-color-text", "--gs-color-surface"],
    ["--gs-color-text", "--gs-color-background"],
    ["--gs-color-text-muted", "--gs-color-surface"],
    ["--gs-color-text-muted", "--gs-color-background"],
    ["--gs-color-link", "--gs-color-surface"],
    ["--gs-color-link", "--gs-color-background"],
    ["--gs-color-white", "--gs-color-action"],
    ["--gs-color-danger-text", "--gs-color-danger-surface"],
    ["--gs-color-warning-text", "--gs-color-warning-surface"],
    ["--gs-color-success-text", "--gs-color-success-surface"],
    ["--gs-header-text", "--gs-header-background"]
  ],
  "$largeTextComment": "Pairs allowed only for large text (>= 18.66px bold or 24px): 3:1. teal-strong on white is about 4.0:1, so body links use --gs-color-link.",
  "largeTextPairs": [
    ["--gs-brand-teal-strong", "--gs-color-white"],
    ["--gs-color-white", "--gs-brand-teal-strong"]
  ]
}
