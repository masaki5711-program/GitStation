{
  "name": "gitstation-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GitStation web UI (ADR-0022): embedded into forge with the forge-web feature embed-ui",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress.mjs dist",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/api/openapi.json --output src/api/schema.gen.ts",
    "i18n:report": "node scripts/i18n-report.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "smoke": "node scripts/smoke.mjs",
    "journey": "node scripts/journey.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "i18next": "25.10.10",
    "openapi-fetch": "0.17.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-i18next": "16.6.6",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
